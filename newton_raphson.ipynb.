        "import sympy as sp\n",
        "\n",
        "def newton_raphson(f_expr, x0, tol=1e-6, max_iter=50):\n",
        "    x = sp.symbols('x')\n",
        "\n",
        "    # المشتقة الأولى والتانية (التانية للتحقق من شرط التقارب)\n",
        "    f   = sp.lambdify(x, f_expr, 'math')\n",
        "    df  = sp.lambdify(x, sp.diff(f_expr, x), 'math')\n",
        "    d2f = sp.lambdify(x, sp.diff(f_expr, x, 2), 'math')\n",
        "\n",
        "    xi = x0\n",
        "    print(\"i    x_i          f(x_i)       f'(x_i)      convergence\")\n",
        "    print(\"-\" * 62)\n",
        "\n",
        "    for i in range(max_iter):\n",
        "        fx, dfx = f(xi), df(xi)\n",
        "\n",
        "        if dfx == 0:\n",
        "            print(\"المشتقة = 0، الميل أفقي ومينفعش نكمل!\")\n",
        "            return None\n",
        "\n",
        "        # شرط التقارب: |f * f'' / (f')^2| < 1\n",
        "        conv = abs(fx * d2f(xi) / dfx**2)\n",
        "        print(f\"{i:<5}{xi:<13.6f}{fx:<13.6f}{dfx:<13.6f}{conv:<12.6f}\")\n",
        "\n",
        "        # القانون: x_{i+1} = x_i - f(x_i)/f'(x_i)\n",
        "        x_next = xi - fx / dfx\n",
        "\n",
        "        if abs(x_next - xi) < tol:\n",
        "            print(f\"\\nالجذر التقريبي: x = {x_next:.8f}  (بعد {i+1} خطوات)\")\n",
        "            return x_next\n",
        "\n",
        "        xi = x_next\n",
        "\n",
        "    print(\"وصلنا للحد الأقصى من التكرارات من غير ما نتقارب\")\n",
        "    return xi\n",
        "\n",
        "\n",
        "# مثال: f(x) = x^2 - 4  (الجذر = 2)\n",
        "x = sp.symbols('x')\n",
        "newton_raphson(x**2 - 4, x0=5)"
      ]
